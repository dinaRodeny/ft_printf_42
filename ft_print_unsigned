int	ft_print_unsigned(unsigned int num)
{
char digit[255];
int i=0;
int n;
if(num==0)
    ft_putchar('0');
while(num)
{

    digit[i]=num%10;
    num/=10;
}    
while(i)
{
    n+=ft_putchar(digit[i]);
    i--;
}
return (n);
}